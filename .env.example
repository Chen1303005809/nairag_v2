# Nairag 的唯一环境配置入口。
#
# 复制为项目根目录的 .env 后，后端、Vite 本地开发服务器和 Docker
# Compose 都会读取它。不要提交 .env，也不要把密钥写入此示例文件。
# 下面所有相对路径都以项目根目录为基准。

# 应用与数据库（直接运行后端时使用本机 PostgreSQL；Compose 会覆盖数据库
# 主机地址及 Docker Secret 挂载路径）。
APP_NAME="Nairag Knowledge Base"
APP_ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://nairag@127.0.0.1:5432/nairag
DATABASE_PASSWORD_FILE=./secrets/postgres_password.txt

# 认证与会话。
JWT_SECRET_FILE=./secrets/jwt_signing_key.txt
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8
SESSION_COOKIE_NAME=nairag_session
CSRF_COOKIE_NAME=nairag_csrf
PRE_AUTH_CSRF_COOKIE_NAME=nairag_pre_auth_csrf
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD_FILE=./secrets/initial_admin_password.txt

# 密码策略。
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=256

# 索引与 worker。
INDEX_ARTIFACT_DIR=./var/index-artifacts
INDEX_BACKEND_MODE=local_artifact
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=300
# WORKER_ID=worker-1
LOG_LEVEL=INFO

# OCR。OCR_DEVICE 在默认 Compose 中固定为 cpu，生产 overlay 会覆盖为 gpu:0。
OCR_DEVICE=cpu
OCR_MAX_IMAGE_BYTES=10485760
OCR_MAX_IMAGE_PIXELS=20000000
OCR_CPU_THREADS=4
PADDLE_PDX_MODEL_SOURCE=BOS
# 直接运行 API 时，取消注释并指向兼容的 OCR 服务；Compose 自动使用内部服务地址。
# OCR_SERVICE_URL=http://127.0.0.1:9003
# OCR_SERVICE_API_KEY_FILE=./secrets/ocr_api_key.txt
OCR_TIMEOUT_SECONDS=60
OCR_TICKET_TTL_SECONDS=600
OCR_KEYWORD_FALLBACK_MIN_CONFIDENCE=0.9

# 开发与测试使用本地私有附件存储。Compose 会将目录映射到持久化卷。
ATTACHMENT_STORAGE_BACKEND=local
ATTACHMENT_STORAGE_DIR=./var/attachments
ATTACHMENT_MAX_FILE_BYTES=20971520

# 生产 MinIO 附件存储（仅在 INDEX_BACKEND_MODE=milvus 时需要）。
# ATTACHMENT_MINIO_ENDPOINT=milvus-minio:19000
# ATTACHMENT_MINIO_ACCESS_KEY_FILE=./secrets/attachment_minio_access_key.txt
# ATTACHMENT_MINIO_SECRET_KEY_FILE=./secrets/attachment_minio_secret_key.txt
ATTACHMENT_MINIO_BUCKET=nairag-attachments
ATTACHMENT_MINIO_SECURE=false

# Milvus 与嵌入服务（生产 Compose overlay 会提供 MILVUS_URL）。
# EMBEDDING_SERVICE_URL=http://embedding.example.internal:9001/v1
# Ollama 原生 embeddings：EMBEDDING_SERVICE_URL=http://192.168.1.100:11434/api
# EMBEDDING_SERVICE_API_KEY_FILE=./secrets/embedding_api_key.txt
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSION=1024
EMBEDDING_TIMEOUT_SECONDS=60
# 生产 Compose 默认启动内置 GPU reranker；设置此项可改用外部兼容服务。
# RERANKER_SERVICE_URL=http://reranker.example.internal:9002
# RERANKER_SERVICE_API_KEY_FILE=./secrets/reranker_api_key.txt
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_TIMEOUT_SECONDS=60
# 分层检索阈值。点赞只在候选通过这些相关度门槛后参与综合排序。
SEARCH_HIGH_CONFIDENCE_THRESHOLD=0.7
SEARCH_RERANK_THRESHOLD=0.5
SEARCH_FALLBACK_THRESHOLD=0.22
SEARCH_CANDIDATE_POOL_SIZE=24
# RERANKER_DEVICE=cuda
# RERANKER_MAX_LENGTH=2048
# RERANKER_BATCH_SIZE=4
# HF_ENDPOINT=https://huggingface.co
# MILVUS_TOKEN_FILE=./secrets/milvus_token.txt

# OpenAI 协议兼容的 LLM（快速上传与快速检索）。真实密钥只写入未跟踪的 .env。
# DeepSeek 示例：OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_BASE_URL=
OPENAI_KEY=
OPENAI_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONVERSATION_MESSAGES=200
LLM_MAX_CONVERSATION_CHARS=30000

# 前端专属配置。VITE_API_BASE_URL 会被打入浏览器产物，不能放置敏感信息。
# 其余浏览器配置由同名后端设置自动派生：CSRF_COOKIE_NAME、
# PRE_AUTH_CSRF_COOKIE_NAME、LLM_MAX_CONVERSATION_MESSAGES、
# LLM_MAX_CONVERSATION_CHARS。
VITE_API_BASE_URL=/api/v1
VITE_PROXY_TARGET=http://127.0.0.1:8000

# 生产 Compose overlay 的 Milvus/MinIO 设置。部署前请为 MinIO 管理账号设定
# 非默认值；附件 Bucket 使用 secrets/ 中独立的低权限账号。
# MILVUS_MINIO_ACCESS_KEY_ID=replace-before-production
# MILVUS_MINIO_SECRET_ACCESS_KEY=replace-before-production
