APP_ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://nairag@127.0.0.1:5432/nairag
DATABASE_PASSWORD_FILE=../secrets/postgres_password.txt
JWT_SECRET_FILE=../secrets/jwt_signing_key.txt
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD_FILE=../secrets/initial_admin_password.txt
COOKIE_SECURE=false
INDEX_ARTIFACT_DIR=./var/index-artifacts
INDEX_BACKEND_MODE=local_artifact
# Required when INDEX_BACKEND_MODE=milvus:
# EMBEDDING_SERVICE_URL=http://host.docker.internal:9001/v1
# EMBEDDING_SERVICE_API_KEY_FILE=../secrets/embedding_api_key.txt
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# EMBEDDING_DIMENSION=1024
# RERANKER_SERVICE_URL=http://host.docker.internal:9002
# RERANKER_SERVICE_API_KEY_FILE=../secrets/reranker_api_key.txt
# RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
# MILVUS_URL=http://milvus:19530
# MILVUS_TOKEN_FILE=../secrets/milvus_token.txt
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=300
# Optional; defaults to HOSTNAME:PID so multiple worker replicas do not share a lease owner.
# WORKER_ID=worker-1
