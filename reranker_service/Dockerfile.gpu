FROM python:3.12.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DEFAULT_TIMEOUT=180 \
    PIP_RETRIES=5 \
    HF_HOME=/var/lib/nairag-reranker/model-cache

WORKDIR /app

COPY requirements.txt ./
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install \
        --index-url https://download.pytorch.org/whl/cu128 \
        torch==2.11.0 \
    && python -m pip install -r requirements.txt \
    && useradd --create-home --uid 10002 reranker \
    && mkdir -p /var/lib/nairag-reranker/model-cache \
    && chown -R reranker:reranker /app /var/lib/nairag-reranker

COPY app ./app
RUN chown -R reranker:reranker /app

USER reranker

EXPOSE 9002

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "9002"]
