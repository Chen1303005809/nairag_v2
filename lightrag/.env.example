# Copy to lightrag/.env. This file belongs to the independent LightRAG stack,
# not to the Nairag platform .env.
LIGHTRAG_POSTGRES_PASSWORD=replace-with-a-long-random-password

# LightRAG's own model-provider credentials and endpoints. They remain inside
# this independent Compose project and are never passed to Nairag's API/web.
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=
LLM_MODEL=gpt-4.1-mini
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_BINDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1024

# Keep the supplementary retrieval envelope aligned with Nairag's proxy.
TOP_K=60
CHUNK_TOP_K=20
MAX_UPLOAD_SIZE=20971520
